# ---------------------------------------------------------------------------
# JaySQL / goInsight — 开源仓库忽略规则
#
# 两条铁律（改动前务必先看）：
#   1. backend/internal/orders/api/mysql/embedded/*/gh-ost 不能忽略 —— 被
#      //go:embed 引用，缺失会直接编译失败。
#   2. backend/web/dist/index.html 不能忽略 —— web.go 里 //go:embed dist，
#      整个 dist 为空时 go build 报错，必须留一个占位文件。
# ---------------------------------------------------------------------------

# ===== macOS / 编辑器 =====
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ===== 本地运行配置（含真实密钥，绝不入库）=====
# 开源请用 backend/config.yaml.template 复制一份再改
backend/config.yaml
backend/config-linux.yaml
config.yaml
config-linux.yaml
*.local.yaml
# Docker 部署：docker compose 用的 .env（含 MySQL 密码）与挂载的配置
docker/.env
docker/config.yaml

# ===== 编译产物：二进制 =====
# （gh-ost 是 go:embed 依赖，见文件头铁律 1，不在忽略范围内）
*.exe
*.exe~
*.dll
*.so
*.dylib
# 第三方运行库：OpenSSL 等（backend/libcrypto.so.10、libssl.so.10）
*.so.*
*.test
*.out
*.tar.gz
*.zip
*.sha256
backend/goinsight
backend/goinsight-linux
backend/goinsight-linux-amd64
backend/main
backend/agentcmd
backend/backup-agent-linux
backend/backfill_order_logs-linux
backend/bin/
backend/goinsight.db
dist/

# ===== 历史发布包 / 调试 / 工具缓存 =====
.deploy-artifacts/
.dbg/
.tmp/
.trae/
.codex/
.npm-cache/
.worktrees/
backend/tmp/
backend/tmp_gen/
backend/media/
backend/logs/
# 带前导斜杠：写成 `logs/` 会忽略掉 www/src/views/audit/logs/ 这个源码目录
/logs/

# ===== 前端 =====
www/node_modules/
www/.vite/
www/.npm-cache/
www/www/
# 正式构建产物
www/dist/
# 历次验证/对比用的临时构建（78 个目录、600M+，命名有 dist-xxx / dist_build 两种）
www/dist-*/
www/dist_build*/
# 文档中心正文产物：由 docs/manual/**/*.md 生成（npm run docs:build）
www/src/views/docs/manifest.json

# ===== 后端前端产物 =====
# 保留 index.html 作为 go:embed 占位（见文件头铁律 2）
backend/web/dist/*
!backend/web/dist/
!backend/web/dist/index.html
backend/web/dist.bak-*/
backend/web/dist.old-*/

# ===== 其他 =====
# 废弃的编辑器备份文件（如 rewrite.go.bak，不参与编译，只是历史残留）
*.bak
*.orig
www/README.md
# 必须带前导斜杠：写成 `assets/` 会把 www/src/assets（前端样式与图片）和
# docs/manual/assets（文档中心配图）一并忽略，clone 后前端构建直接报 ENOENT
/assets/
go.work
go.work.sum
